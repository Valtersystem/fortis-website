---
import Base from './Base.astro';
import Footer from '../components/Footer.astro';
import { site } from '../content/site';
import { url } from '../lib/config';

interface Props { titulo: string; descricao: string; }
const { titulo, descricao } = Astro.props;
const rascunho = !site.legal.entidade;
---
<Base titulo={`${titulo} | ${site.nome}`} descricao={descricao} noindex>
  <header class="lg-header">
    <div class="container">
      <a href={url('/')} aria-label="Voltar à página inicial da FORTIS">
        <img src={url('brand/logo-horizontal-white.png')} alt="FORTIS" width="1045" height="200" />
      </a>
      <a class="lg-voltar" href={url('/')}>← Voltar ao site</a>
    </div>
  </header>
  <main id="conteudo" class="lg">
    <div class="container lg__corpo">
      <h1>{titulo}</h1>
      <p class="lg__data">Última atualização: {site.legal.versaoPolitica}</p>
      {rascunho && (
        <p class="lg__rascunho" role="note">
          Documento em preparação. Os campos assinalados entre parênteses retos serão preenchidos antes da publicação oficial do site.
        </p>
      )}
      <slot />
    </div>
  </main>
  <Footer />
</Base>

<style>
  .lg-header { background: var(--antracite); border-bottom: 1px solid var(--linha-escura); }
  .lg-header .container { height: var(--header-h); display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .lg-header img { height: 28px; width: auto; }
  .lg-voltar { color: var(--texto-claro-2); font-size: 14px; font-weight: 600; text-decoration: none; min-height: 44px; display: flex; align-items: center; }
  .lg-voltar:hover { color: var(--branco); }
  .lg { background: var(--branco); color: var(--antracite); padding: clamp(56px, 8vw, 96px) 0; }
  .lg__corpo { max-width: 820px; }
  .lg h1 { margin: 0; font-size: clamp(32px, 4vw, 48px); font-weight: 800; text-transform: uppercase; letter-spacing: -.02em; line-height: 1.1; }
  .lg__data { color: var(--texto-escuro-3); font-size: 14px; margin: 12px 0 32px; }
  .lg__rascunho { border: 1.5px dashed #b7791f; background: #fff8e6; padding: 14px 18px; font-size: 14px; color: #5c3d00; }
  .lg :global(h2) { font-size: 20px; font-weight: 800; text-transform: uppercase; letter-spacing: .02em; margin: 40px 0 12px; }
  .lg :global(p), .lg :global(li) { font-size: 16px; line-height: 1.7; color: #333; }
  .lg :global(a) { color: var(--vermelho-escuro); font-weight: 600; }
  .lg :global(table) { width: 100%; border-collapse: collapse; font-size: 15px; display: block; overflow-x: auto; }
  .lg :global(th), .lg :global(td) { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--cinza); vertical-align: top; }
</style>
