# Copiar para .env (desenvolvimento local) ou definir no painel do alojamento.
# Nenhuma destas variáveis é secreta: todas acabam no HTML público.
# Credenciais (SMTP, chaves de API) NUNCA vão para aqui — ficam no serviço de formulários.

# URL pública do site e caminho base
SITE_URL=https://www.exemplo.pt
BASE_PATH=/

# Formulário — "netlify" | "endpoint" | vazio (desligado)
PUBLIC_FORM_PROVIDER=endpoint
# Só para "endpoint": URL que recebe o POST do formulário (ex.: https://formspree.io/f/xxxxxxx)
PUBLIC_FORM_ENDPOINT=

# Google Analytics 4 — vazio = sem analytics e sem banner de cookies
PUBLIC_GA4_ID=

# true = mostra conteúdos ainda por confirmar, com etiqueta "Por confirmar" (só para testes/revisão)
PUBLIC_PREVIEW=false

# true = permite indexação pelos motores de busca (só depois de aprovado)
PUBLIC_INDEXAR=false
